{
  "name": "code-skater",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser arcade skate game. Compile the line. Fetch the drive.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:private": "vite build --mode private",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "zip": "node scripts/zip.mjs",
    "lint": "eslint .",
    "check:parody": "node scripts/check-parody.mjs",
    "check:size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.0",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
